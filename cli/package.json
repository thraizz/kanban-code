{
  "name": "@kanban-code/cli",
  "version": "0.1.0",
  "description": "Kanban Code CLI — inspect cards, sessions, and orchestrate agents",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "kanban": "./dist/kanban.js",
    "kv": "./dist/kv.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsx src/kanban.ts",
    "test": "tsx --test --test-force-exit --test-reporter=spec 'src/*.test.ts'",
    "prepack": "tsc"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
