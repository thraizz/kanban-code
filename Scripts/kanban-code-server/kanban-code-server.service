[Unit]
Description=Kanban Code headless master (remote control API on loopback and the bind addresses)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=SHELL=/bin/bash
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Listens on 127.0.0.1 plus settings remoteControl.bindAddresses; add
# `--bind <addr>` (repeatable) here to override them.
ExecStart=/usr/local/bin/kanban-code-server
Restart=always
RestartSec=3
# The rush hosts, tmux servers and assistants the server starts outlive it:
# a restart or deploy stops only the server, and it reattaches to them.
KillMode=process
# rush hosts, transcripts and sockets add up to many open files.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
